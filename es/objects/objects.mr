// Function
public node function => __engine_sim__function {
    input filter_radius [float]: 1.0;
    alias output __out [function_channel];
}

// Cylinder
public node cylinder_friction_parameter_defaults {
    output friction_k: 0.06;
    output breakaway_friction: 0.0;
    output breakaway_friction_velocity: 0.0;
    output viscous_friction_coefficient: 0.0;
}

public node cylinder_friction_parameters {
    input copy: cylinder_friction_parameter_defaults();
    input friction_k: copy.friction_k;
    input breakaway_friction: copy.breakaway_friction;
    input breakaway_friction_velocity: copy.breakaway_friction_velocity;
    input viscous_friction_coefficient: copy.viscous_friction_coefficient;
}

// Valvetrain
public node standard_valvetrain => __engine_sim__standard_valvetrain {
    input intake_camshaft [camshaft];
    input exhaust_camshaft [camshaft];
    alias output __out [valvetrain_channel];
}

public node vtec_valvetrain => __engine_sim__vtec_valvetrain {
    input vtec_intake_camshaft [camshaft];
    input vtec_exhaust_camshaft [camshaft];
    input intake_camshaft [camshaft];
    input exhaust_camshaft [camshaft];

    input min_rpm [float]: 5800 * units.rpm;
    input min_speed [float]: 10 * units.mph;
    input manifold_vacuum [float]: 1.0 * units.atm - 5.0 * units.inHg;
    input min_throttle_position [float]: 0.3;

    alias output __out [valvetrain_channel];
}

// Cylinder Head
public node cylinder_head_parameters {
    input intake_port_flow: function();
    input exhaust_port_flow: function();
    input chamber_volume: 118.0 * units.cc;

    input intake_runner_volume: 300.0 * units.cc;
    input intake_runner_cross_section_area: circle_area(0.75 * units.inch);

    input exhaust_runner_volume: 300.0 * units.cc;
    input exhaust_runner_cross_section_area: circle_area(0.85 * units.inch);

    input flip_display: false;
}

private node _cylinder_head => __engine_sim__cylinder_head {
    input intake_port_flow [function];
    input exhaust_port_flow [function];
    input valvetrain [valvetrain_channel];
    input chamber_volume [float];
    input intake_runner_volume [float];
    input intake_runner_cross_section_area [float];
    input exhaust_runner_volume [float];
    input exhaust_runner_cross_section_area [float];
    input flip_display [bool];
    alias output __out [cylinder_head_channel];
}

public node generic_cylinder_head {
    input parameters: cylinder_head_parameters();
    input valvetrain;

    input intake_port_flow: parameters.intake_port_flow;
    input exhaust_port_flow: parameters.exhaust_port_flow;

    input chamber_volume: parameters.chamber_volume;

    input intake_runner_volume: parameters.intake_runner_volume;
    input intake_runner_cross_section_area: parameters.intake_runner_cross_section_area;

    input exhaust_runner_volume: parameters.exhaust_runner_volume;
    input exhaust_runner_cross_section_area: parameters.exhaust_runner_cross_section_area;

    input flip_display: parameters.flip_display;

    alias output __out [_cylinder_head]:
        _cylinder_head(
            intake_port_flow: intake_port_flow,
            exhaust_port_flow: exhaust_port_flow,
            chamber_volume: chamber_volume,
            intake_runner_volume: intake_runner_volume,
            intake_runner_cross_section_area: intake_runner_cross_section_area,
            exhaust_runner_volume: exhaust_runner_volume,
            exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,
            flip_display: flip_display,
            valvetrain: valvetrain
        );
}

public node cylinder_head {
    input parameters: cylinder_head_parameters();

    input intake_camshaft;
    input exhaust_camshaft;

    input intake_port_flow: parameters.intake_port_flow;
    input exhaust_port_flow: parameters.exhaust_port_flow;

    input chamber_volume: parameters.chamber_volume;

    input intake_runner_volume: parameters.intake_runner_volume;
    input intake_runner_cross_section_area: parameters.intake_runner_cross_section_area;

    input exhaust_runner_volume: parameters.exhaust_runner_volume;
    input exhaust_runner_cross_section_area: parameters.exhaust_runner_cross_section_area;

    input flip_display: parameters.flip_display;

    alias output __out [_cylinder_head]:
        generic_cylinder_head(
            intake_port_flow: intake_port_flow,
            exhaust_port_flow: exhaust_port_flow,
            chamber_volume: chamber_volume,
            intake_runner_volume: intake_runner_volume,
            intake_runner_cross_section_area: intake_runner_cross_section_area,
            exhaust_runner_volume: exhaust_runner_volume,
            exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,
            flip_display: flip_display,
            valvetrain: standard_valvetrain(
                intake_camshaft: intake_camshaft,
                exhaust_camshaft: exhaust_camshaft
            )
        );
}

// Camshaft
public node camshaft_parameters {
    input advance: 0.0;
    input base_radius: 0.0;
    input lobe_profile: function();
    input reduction_ratio: 0.5;
}

private node _camshaft => __engine_sim__camshaft {
    input advance [float];
    input base_radius [float];
    input lobe_profile [function];
    input reduction_ratio [float];
    alias output __out [camshaft_channel];
}

public node camshaft {
    input parameters: camshaft_parameters();
    input advance: parameters.advance;
    input base_radius: parameters.base_radius;
    input lobe_profile: parameters.lobe_profile;
    input reduction_ratio: parameters.reduction_ratio;
    alias output __out [_camshaft]:
        _camshaft(
            advance: advance,
            base_radius: base_radius,
            lobe_profile: lobe_profile,
            reduction_ratio: reduction_ratio
        );
}

// Intake
public node intake_parameters {
    input plenum_volume: 2.0 * units.L;
    input plenum_cross_section_area: 100.0 * units.cm2;
    input intake_flow_rate: 0.0;
    input idle_flow_rate: 0.0;
    input molecular_afr: (25.0 / 2.0);
    input idle_throttle_plate_position: 0.975;
    input throttle_gamma: 2.0;
    input runner_length: 4.0 * units.inch;
    input runner_flow_rate: k_carb(200.0);
    input velocity_decay: 0.25;
    input atmosphere_pressure: 1.0 * units.atm;
    input atmosphere_temperature: 25.0 + units.K0;
}

private node _intake => __engine_sim__intake {
    input plenum_volume [float];
    input plenum_cross_section_area [float];
    input intake_flow_rate [float];
    input idle_flow_rate [float];
    input runner_flow_rate [float];
    input molecular_afr [float];
    input idle_throttle_plate_position [float];
    input throttle_gamma [float];
    input runner_length [float];
    input velocity_decay [float];
    input atmosphere_pressure [float];
    input atmosphere_temperature [float];
    alias output __out [intake_channel];
}

public node intake {
    input parameters: intake_parameters();
    input plenum_volume: parameters.plenum_volume;
    input plenum_cross_section_area: parameters.plenum_cross_section_area;
    input intake_flow_rate: parameters.intake_flow_rate;
    input idle_flow_rate: parameters.idle_flow_rate;
    input runner_flow_rate: parameters.runner_flow_rate;
    input molecular_afr: parameters.molecular_afr;
    input idle_throttle_plate_position: parameters.idle_throttle_plate_position;
    input throttle_gamma: parameters.throttle_gamma;
    input runner_length: parameters.runner_length;
    input velocity_decay: parameters.velocity_decay;
    input atmosphere_pressure: parameters.atmosphere_pressure;
    input atmosphere_temperature: parameters.atmosphere_temperature;
    alias output __out [_intake]:
        _intake(
            plenum_volume: plenum_volume,
            plenum_cross_section_area: plenum_cross_section_area,
            intake_flow_rate: intake_flow_rate,
            idle_flow_rate: idle_flow_rate,
            runner_flow_rate: runner_flow_rate,
            molecular_afr: molecular_afr,
            idle_throttle_plate_position: idle_throttle_plate_position,
            throttle_gamma: throttle_gamma,
            runner_length: runner_length,
            velocity_decay: velocity_decay,
            atmosphere_pressure: atmosphere_pressure,
            atmosphere_temperature: atmosphere_temperature
        );
}

// Exhaust System
public node impulse_response => __engine_sim__impulse_response {
    input filename [string];
    input volume [float]: 1.0;
    alias output __out [impulse_response_channel];
}

public node exhaust_system_parameters {
    input volume: 100.0 * units.L;
    input length: volume / collector_cross_section_area;
    input collector_cross_section_area: circle_area(2.0 * units.inch);
    input outlet_flow_rate: k_carb(1000.0);
    input primary_tube_length: 10.0 * units.inch;
    input primary_flow_rate: k_carb(100.0);
    input audio_volume: 1.0;
    input velocity_decay: 1.0;
}

private node _exhaust_system => __engine_sim__exhaust_system {
    input length [float];
    input collector_cross_section_area [float];
    input outlet_flow_rate [float];
    input primary_tube_length [float];
    input primary_flow_rate [float];
    input audio_volume [float];
    input velocity_decay [float];
    input impulse_response [impulse_response];
    alias output __out [exhaust_system_channel];
}

public node exhaust_system {
    input parameters: exhaust_system_parameters();
    input length: parameters.length;
    input collector_cross_section_area: parameters.collector_cross_section_area;
    input outlet_flow_rate: parameters.outlet_flow_rate;   
    input primary_tube_length: parameters.primary_tube_length;
    input primary_flow_rate: parameters.primary_flow_rate;
    input audio_volume: parameters.audio_volume;
    input velocity_decay: parameters.velocity_decay;
    input impulse_response;
    alias output __out [_exhaust_system]:
        _exhaust_system(
            length: length,
            collector_cross_section_area: collector_cross_section_area,
            outlet_flow_rate: outlet_flow_rate,
            primary_tube_length: primary_tube_length,
            primary_flow_rate: primary_flow_rate,
            audio_volume: audio_volume,
            velocity_decay: velocity_decay,
            impulse_response: impulse_response
        );
}

// Ignition Module
public node ignition_module => __engine_sim__ignition_module {
    input timing_curve [function];
    input rev_limit [float]: 7000.0 * units.rpm;
    input limiter_duration [float]: 0.5 * units.sec;
    input sparks_per_cycle [float]: 1;
    alias output __out [ignition_module_channel];
}

public node ignition_wire => __engine_sim__ignition_wire {
    alias output __out [ignition_wire_channel];
}

public node vehicle => __engine_sim__vehicle {
    input mass [float]: 1000 * units.kg;
    input drag_coefficient [float]: 0.25;
    input cross_sectional_area [float]: (72 * units.inch) * (72 * units.inch);
    input diff_ratio [float]: 3.42;
    input tire_radius [float]: 10 * units.inch;
    input rolling_resistance [float]: 2000;
    input max_brake_force [float]: 0; // 0: about 1 g for the vehicle's mass

    alias output __out [vehicle_channel];
}

public node transmission => __engine_sim__transmission {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    alias output __out [transmission_channel];
}

// Turbochargers and superchargers (from kyan0s-git/engine-sim). Add one to
// an engine with add_forced_induction(). The compressor feeds every intake
// and draws from their atmosphere; a turbocharger's turbine sits at the
// outlet of every exhaust system.
private node _forced_induction => __engine_sim__forced_induction {
    input type [string];
    input arrangement [string];
    input compressor_diameter [float];
    input compressor_flow [float];
    input compressor_efficiency [float];
    input max_speed [float];
    input turbine_ar [float];
    input turbine_diameter [float];
    input variable_geometry [bool];
    input min_turbine_ar [float];
    input exhaust_sound [string];
    input turbine_efficiency [float];
    input inertia [float];
    input bearings [string];
    input boost [float];
    input blowoff_valve [bool];
    input drive_ratio [float];
    input displacement [float];
    input bypass_valve [bool];
    input throttle_position [string];
    input rotor_lobes [int];
    input rotor_efficiency [float];
    input rotor_twist [float];
    input gear_teeth [int];
    input gear_whine [float];
    input whine_volume [float];
    input intercooler_effectiveness [float];
    input charge_volume [float];
    input sequential_speed [float];
    input blowoff_type [string];
    input boost_control [string];
    input wastegate [string];
    input wastegate_off_boost [string];
    input twin_scroll [bool];
    input whistle_pitch [float];
    input compressor_blades [int];
    input splitter_blades [int];
    input compressor_inlet [string];
    input bearing_wear [float];
    input wastegate_rattle [float];
    input boost_leak [float];
    input anti_lag [bool];
    input anti_lag_timing [float];
    input anti_lag_throttle [float];
    input anti_lag_min_speed [float];
    alias output __out [forced_induction_channel];
}

// arrangement: "single", "twin" (parallel) or "sequential"
// compressor_flow: maximum compressor flow [mass / time]
// max_speed: shaft speed limit (0: from the compressor wheel's tip speed limit)
// bearings: "journal" or "ball"
// boost: wastegate set point (gauge pressure)
// turbine_diameter: turbine wheel (0: sized from the compressor_flow)
// variable_geometry: vanes in the turbine housing hold the boost instead of a
// wastegate, acting as min_turbine_ar when closed (0: 0.25 * turbine_ar) and
// turbine_ar when open
// exhaust_sound: "after_turbine" (the turbine smooths the pulses and takes its
// share of their pressure, as a muffler does) or "before_turbine"
// compressor_inlet: what the compressor draws through, which decides how much
// of its whistle gets out: "silenced" (a factory airbox with a resonator),
// "airbox" or "open" (an open filter)
// bearing_wear: worn shaft bearings, from 0 (new) to 1 (worn out): a whine
// below the whistle (journal bearings) or a rough tone above it (ball)
// wastegate_rattle: a worn wastegate linkage, 0 to 1: the open flapper
// rattles on each exhaust pulse
// boost_leak: a hole or split coupler in the charge pipe, as its diameter:
// it hisses and costs boost
// anti_lag: a "bang-bang" anti-lag system. Off the throttle above
// anti_lag_min_speed it holds the throttle open by anti_lag_throttle and
// fires the spark at anti_lag_timing (after top dead centre), so the mixture
// burns on in the exhaust manifold: it bangs and keeps the turbo spinning
public node turbocharger {
    input arrangement: "single";
    input compressor_diameter: 60 * units.mm;
    input compressor_flow: 0.3 * units.kg / units.sec;
    input compressor_efficiency: 0.75;
    input max_speed: 0.0;
    input turbine_ar: 0.64;
    input turbine_diameter: 0.0;
    input variable_geometry: false;
    input min_turbine_ar: 0.0;
    input exhaust_sound: "after_turbine";
    input turbine_efficiency: 0.7;
    input inertia: 0.00003;
    input bearings: "journal";
    input boost: 100.0 * units.kPa;
    input blowoff_valve: true;
    input intercooler_effectiveness: 0.7;
    input charge_volume: 6.0 * units.L;
    input sequential_speed: 4000 * units.rpm;
    input blowoff_type: "atmospheric";      // "atmospheric", "recirculating" or "none"
    input boost_control: "electronic";      // "electronic" or "spring"
    input wastegate: "internal";            // "internal" or "external"
    input wastegate_off_boost: "closed";    // "closed", or "open" (electric actuators)
    input twin_scroll: false;
    input whistle_pitch: 1.0;
    input compressor_blades: 6;             // full blades of the compressor wheel
    input splitter_blades: 6;               // splitter blades between them
    input compressor_inlet: "silenced";     // "silenced", "airbox" or "open"
    input bearing_wear: 0.0;
    input wastegate_rattle: 0.0;
    input boost_leak: 0.0 * units.mm;
    input anti_lag: false;
    input anti_lag_timing: -30 * units.deg;
    input anti_lag_throttle: 0.25;
    input anti_lag_min_speed: 3000 * units.rpm;
    alias output __out:
        _forced_induction(
            type: "turbo",
            arrangement: arrangement,
            compressor_diameter: compressor_diameter,
            compressor_flow: compressor_flow,
            compressor_efficiency: compressor_efficiency,
            max_speed: max_speed,
            turbine_ar: turbine_ar,
            turbine_diameter: turbine_diameter,
            variable_geometry: variable_geometry,
            min_turbine_ar: min_turbine_ar,
            exhaust_sound: exhaust_sound,
            turbine_efficiency: turbine_efficiency,
            inertia: inertia,
            bearings: bearings,
            boost: boost,
            blowoff_valve: blowoff_valve,
            drive_ratio: 1.0,
            displacement: 0.0,
            bypass_valve: false,
            throttle_position: "after",
            rotor_lobes: 0,
            rotor_efficiency: 0.0,
            rotor_twist: 0.0,
            gear_teeth: 0,
            gear_whine: 0.0,
            whine_volume: 1.0,
            intercooler_effectiveness: intercooler_effectiveness,
            charge_volume: charge_volume,
            sequential_speed: sequential_speed,
            blowoff_type: blowoff_type,
            boost_control: boost_control,
            wastegate: wastegate,
            wastegate_off_boost: wastegate_off_boost,
            twin_scroll: twin_scroll,
            whistle_pitch: whistle_pitch,
            compressor_blades: compressor_blades,
            splitter_blades: splitter_blades,
            compressor_inlet: compressor_inlet,
            bearing_wear: bearing_wear,
            wastegate_rattle: wastegate_rattle,
            boost_leak: boost_leak,
            anti_lag: anti_lag,
            anti_lag_timing: anti_lag_timing,
            anti_lag_throttle: anti_lag_throttle,
            anti_lag_min_speed: anti_lag_min_speed
        );
}

// type: "roots", "twin_screw" or "centrifugal"
// drive_ratio: compressor speed / crankshaft speed (centrifugal superchargers
// include the gearbox step-up; 0: 2.0 for roots and twin_screw, 10.0 for
// centrifugal)
// compressor_diameter: centrifugal (0: 133 mm, a ProCharger P-1SC's)
// rotor_efficiency: adiabatic efficiency of the rotors (0: 0.55 for roots,
// 0.72 for twin_screw; an Eaton TVS is better than the older roots)
// displacement: air moved per rotor revolution (roots and twin_screw)
// rotor_lobes: lobes on each rotor (0: 3; a twin_screw's male rotor, which
// the drive_ratio turns, usually has 3 against the female's 5); a roots blower whines at twice its lobes per rotor turn
// rotor_twist: the rotors' twist over their length (roots): the more twist,
// the purer the whine (60 deg: Eaton M-series and GMC, 160 deg: Eaton TVS)
// gear_teeth: teeth on the drive gear on the compressor's shaft (the timing
// gears of a roots or twin_screw, a centrifugal's step-up pinion): they whine
// at teeth times its speed (0: no gear whine); gear_whine scales it
// throttle_position: where the engine's throttle is, roots and twin_screw:
// "after" the blower (the throttle body feeds the manifold from the charge
// air) or "before" it (butterflies in a hat on top of the blower, as drag
// and monster truck engines have: the blower draws through the throttle, so
// at part throttle it moves thin air and makes little or no boost)
public node supercharger {
    input type: "roots";
    input drive_ratio: 0.0;
    input displacement: 1.9 * units.L;
    input compressor_diameter: 0.0;
    input compressor_flow: 0.5 * units.kg / units.sec;
    input compressor_efficiency: 0.75;
    input max_speed: 0.0;
    input bypass_valve: true;
    input throttle_position: "after";       // "after" or "before" the blower
    input rotor_lobes: 0;
    input rotor_efficiency: 0.0;
    input rotor_twist: 60 * units.deg;
    input gear_teeth: 0;
    input gear_whine: 1.0;
    input whine_volume: 1.0;              // all of its whine; some makers silence it
    input blowoff_valve: true;
    input intercooler_effectiveness: 0.0;
    input charge_volume: 4.0 * units.L;
    input blowoff_type: "atmospheric";
    input whistle_pitch: 1.0;
    input compressor_blades: 6;             // full blades of the compressor wheel
    input splitter_blades: 6;               // splitter blades between them
    input compressor_inlet: "silenced";     // "silenced", "airbox" or "open"
    input boost_leak: 0.0 * units.mm;       // a hole in the charge pipe (diameter)
    alias output __out:
        _forced_induction(
            type: type,
            arrangement: "single",
            compressor_diameter: compressor_diameter,
            compressor_flow: compressor_flow,
            compressor_efficiency: compressor_efficiency,
            max_speed: max_speed,
            turbine_ar: 0.64,
            turbine_diameter: 0.0,
            variable_geometry: false,
            min_turbine_ar: 0.0,
            exhaust_sound: "before_turbine",
            turbine_efficiency: 0.7,
            inertia: 0.00003,
            bearings: "ball",
            boost: 0.0,
            blowoff_valve: blowoff_valve,
            drive_ratio: drive_ratio,
            displacement: displacement,
            bypass_valve: bypass_valve,
            throttle_position: throttle_position,
            rotor_lobes: rotor_lobes,
            rotor_efficiency: rotor_efficiency,
            rotor_twist: rotor_twist,
            gear_teeth: gear_teeth,
            gear_whine: gear_whine,
            whine_volume: whine_volume,
            intercooler_effectiveness: intercooler_effectiveness,
            charge_volume: charge_volume,
            sequential_speed: 0.0,
            blowoff_type: blowoff_type,
            boost_control: "electronic",
            wastegate: "internal",
            wastegate_off_boost: "closed",
            twin_scroll: false,
            whistle_pitch: whistle_pitch,
            compressor_blades: compressor_blades,
            splitter_blades: splitter_blades,
            compressor_inlet: compressor_inlet,
            bearing_wear: 0.0,
            wastegate_rattle: 0.0,
            boost_leak: boost_leak,
            anti_lag: false,
            anti_lag_timing: 0.0,
            anti_lag_throttle: 0.0,
            anti_lag_min_speed: 0.0
        );
}

// Diesel injection and combustion (docs/diesel.md). Add it to an engine with
// add_diesel_injection(): the intakes then pass air only and stay wide open,
// the pedal sets the fuel, and the ignition module's timing curve becomes the
// injection timing.
private node _diesel_injection => __engine_sim__diesel_injection {
    input idle_speed [float];
    input max_speed [float];
    input governor_droop [float];
    input start_fuel [float];
    input full_load_lambda [float];
    input injection_duration [float];
    input pilot_injection [bool];
    input pilot_fuel [float];
    input pilot_separation [float];
    input ignition_delay [float];
    input premixed_share [float];
    input combustion_noise [float];
    input injector_noise [float];
    alias output __out [diesel_injection_channel];
}

// idle_speed: the governor holds it with the fuel when the pedal is up
// max_speed: governed speed, where the fuel is cut back (0: none)
// full_load_lambda: air over stoichiometric at full fuel (the smoke limit)
// injection_duration: main injection at full fuel, in time (the rail pressure
// sets the rate, so at high rpm it spans more crank angle and burns later)
// pilot_fuel: share of the full load fuel; pilot_separation: crank angle from
// the pilot to the main injection
// ignition_delay: scales the ignition delay; premixed_share: share of the
// fuel sprayed in during the delay that burns at once (the knock)
public node diesel_injection {
    input idle_speed: 750 * units.rpm;
    input max_speed: 0.0;
    input governor_droop: 0.06;
    input start_fuel: 0.6;
    input full_load_lambda: 1.3;
    input injection_duration: 0.002 * units.sec;
    input pilot_injection: true;
    input pilot_fuel: 0.03;
    input pilot_separation: 15 * units.deg;
    input ignition_delay: 1.0;
    input premixed_share: 0.7;
    input combustion_noise: 1.0;
    input injector_noise: 1.0;
    alias output __out:
        _diesel_injection(
            idle_speed: idle_speed,
            max_speed: max_speed,
            governor_droop: governor_droop,
            start_fuel: start_fuel,
            full_load_lambda: full_load_lambda,
            injection_duration: injection_duration,
            pilot_injection: pilot_injection,
            pilot_fuel: pilot_fuel,
            pilot_separation: pilot_separation,
            ignition_delay: ignition_delay,
            premixed_share: premixed_share,
            combustion_noise: combustion_noise,
            injector_noise: injector_noise
        );
}
