From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:00:00 +0300
Subject: [PATCH] Find FlexLexer.h next to the flex executable

Patch 0003 only used the installed header when FindFLEX located it.
Homebrew's flex is keg-only, so with FLEX_EXECUTABLE pointed at it the
header in its own include directory wasn't found, the bundled 2.6.4
header was used, and the scanner from the newer flex failed to compile
("out-of-line definition of 'yyread'", "yy_state_buf_max"). Look beside
the executable first (../include, or the same directory as win_flex
keeps it), then FindFLEX's result, then the bundled copy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8f7fbe24..18a79fc7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,10 +46,20 @@ add_flex_bison_dependency(lexer parser)
 
 include_directories(${CMAKE_CURRENT_BINARY_DIR})
 # The scanner flex generates only compiles against the FlexLexer.h of the
-# same flex version, so use the installed flex's header when CMake finds
-# it and fall back to the bundled copy (flex 2.6.4) otherwise
-if (FLEX_INCLUDE_DIRS AND EXISTS "${FLEX_INCLUDE_DIRS}/FlexLexer.h")
-    include_directories(${FLEX_INCLUDE_DIRS})
+# same flex version. Look next to the flex in use first (Homebrew's flex is
+# keg-only, so its header isn't on the default search path; win_flex keeps it
+# beside the executable), then where FindFLEX looked, and fall back to the
+# bundled copy (flex 2.6.4)
+get_filename_component(flex_bin_dir "${FLEX_EXECUTABLE}" DIRECTORY)
+set(flex_header_dir "")
+foreach (dir "${flex_bin_dir}/../include" "${flex_bin_dir}" ${FLEX_INCLUDE_DIRS})
+    if (NOT flex_header_dir AND EXISTS "${dir}/FlexLexer.h")
+        get_filename_component(flex_header_dir "${dir}" ABSOLUTE)
+    endif ()
+endforeach ()
+if (flex_header_dir)
+    message(STATUS "piranha: using FlexLexer.h from ${flex_header_dir}")
+    include_directories(${flex_header_dir})
 else ()
     include_directories(dependencies/libraries/flex/include)
 endif ()
