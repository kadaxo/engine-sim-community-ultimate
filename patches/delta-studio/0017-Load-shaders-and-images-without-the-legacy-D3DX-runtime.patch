diff --git a/include/yds_d3d_file_loading.h b/include/yds_d3d_file_loading.h
new file mode 100644
index 00000000..541ad731
--- /dev/null
+++ b/include/yds_d3d_file_loading.h
@@ -0,0 +1,30 @@
+#ifndef YDS_D3D_FILE_LOADING_H
+#define YDS_D3D_FILE_LOADING_H
+
+// Shader and image loading for the Direct3D 10 and 11 devices, using only
+// what Windows 10 and later include (d3dcompiler_47.dll) and SDL_image, in
+// place of the legacy D3DX runtime that has to be installed separately.
+
+#include <d3dcommon.h>
+
+#include <string>
+#include <vector>
+
+// Compiles one entry point of an HLSL file. On failure, message holds the
+// compiler's output, or why the file couldn't be read.
+HRESULT ysD3DCompileShaderFile(
+    const char *filename,
+    const char *entryPoint,
+    const char *target,
+    ID3DBlob **blob,
+    std::string *message);
+
+// Reads an image file as rows of 8-bit RGBA pixels with no padding.
+bool ysLoadRgbaImage(
+    const char *filename,
+    std::vector<unsigned char> *pixels,
+    int *width,
+    int *height,
+    std::string *message);
+
+#endif /* YDS_D3D_FILE_LOADING_H */
diff --git a/src/yds_d3d_file_loading.cpp b/src/yds_d3d_file_loading.cpp
new file mode 100644
index 00000000..00a36f16
--- /dev/null
+++ b/src/yds_d3d_file_loading.cpp
@@ -0,0 +1,98 @@
+#include "../include/yds_d3d_file_loading.h"
+
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <SDL_image.h>
+
+#include <algorithm>
+
+HRESULT ysD3DCompileShaderFile(
+    const char *filename,
+    const char *entryPoint,
+    const char *target,
+    ID3DBlob **blob,
+    std::string *message)
+{
+    *blob = nullptr;
+    message->clear();
+
+    // The device API takes file names in the ANSI code page, as D3DX did
+    const int length = MultiByteToWideChar(CP_ACP, 0, filename, -1, nullptr, 0);
+    if (length <= 0) {
+        *message = std::string("Invalid shader file name: ") + filename;
+        return E_INVALIDARG;
+    }
+
+    std::wstring wideFilename(length, L'\0');
+    MultiByteToWideChar(CP_ACP, 0, filename, -1, &wideFilename[0], length);
+
+    ID3DBlob *errors = nullptr;
+    const HRESULT result = D3DCompileFromFile(
+        wideFilename.c_str(),
+        nullptr,
+        D3D_COMPILE_STANDARD_FILE_INCLUDE,
+        entryPoint,
+        target,
+        D3DCOMPILE_ENABLE_STRICTNESS,
+        0,
+        blob,
+        &errors);
+
+    if (errors != nullptr) {
+        if (FAILED(result)) {
+            message->assign(
+                static_cast<const char *>(errors->GetBufferPointer()),
+                errors->GetBufferSize());
+        }
+        errors->Release();
+    }
+
+    // A missing or unreadable file fails without compiler output
+    if (FAILED(result) && message->empty()) {
+        *message = std::string("Could not read shader file: ") + filename;
+    }
+
+    return result;
+}
+
+bool ysLoadRgbaImage(
+    const char *filename,
+    std::vector<unsigned char> *pixels,
+    int *width,
+    int *height,
+    std::string *message)
+{
+    pixels->clear();
+    *width = *height = 0;
+
+    SDL_Surface *loaded = IMG_Load(filename);
+    if (loaded == nullptr) {
+        *message = std::string(filename) + ": " + IMG_GetError();
+        return false;
+    }
+
+    // RGBA32 is R, G, B, A in memory, which is DXGI_FORMAT_R8G8B8A8_UNORM
+    SDL_Surface *rgba = SDL_ConvertSurfaceFormat(loaded, SDL_PIXELFORMAT_RGBA32, 0);
+    SDL_FreeSurface(loaded);
+    if (rgba == nullptr) {
+        *message = std::string(filename) + ": " + SDL_GetError();
+        return false;
+    }
+
+    const size_t rowBytes = static_cast<size_t>(rgba->w) * 4;
+    pixels->resize(rowBytes * rgba->h);
+
+    SDL_LockSurface(rgba);
+    for (int y = 0; y < rgba->h; ++y) {
+        const unsigned char *row =
+            static_cast<const unsigned char *>(rgba->pixels) + static_cast<size_t>(y) * rgba->pitch;
+        std::copy(row, row + rowBytes, pixels->begin() + y * rowBytes);
+    }
+    SDL_UnlockSurface(rgba);
+
+    *width = rgba->w;
+    *height = rgba->h;
+    SDL_FreeSurface(rgba);
+
+    return true;
+}
