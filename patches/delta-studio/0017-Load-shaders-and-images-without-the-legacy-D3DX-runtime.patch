From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:30:00 +0300
Subject: [PATCH] Load shaders and images without the legacy D3DX runtime

The Direct3D 10 and 11 devices compiled shaders and read image files with
D3DX, which isn't part of Windows: it comes from the DirectX End-User
Runtime of 2010, which may only be installed with Microsoft's own setup
program. Without it, programs built with delta-studio failed to start on
a clean Windows install ("d3dx11_43.dll was not found").

Shaders are now compiled with D3DCompileFromFile from d3dcompiler_47.dll,
which Windows 10 and later include, and image files are read with
SDL_image, as the OpenGL device already does. A shader file that can't
be read now reports why instead of dereferencing a missing error blob,
and the Direct3D 10 device reports the compiler's message instead of an
uninitialized buffer.
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 119ee9d8..114eeed0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -257,26 +257,25 @@ if(ENABLE_D3D)
         include/yds_d3d11_utilities.h
     )
 
-    set(
-        D3DX_LIBS
-        ${CMAKE_CURRENT_SOURCE_DIR}/dependencies/libraries/D3DX/lib/${TARGET_ARCHITECTURE})
+    # Shaders are compiled with d3dcompiler_47.dll, which Windows 10 and
+    # later include, and image files are read with SDL_image, instead of the
+    # legacy D3DX runtime
+    if (NOT ENABLE_SDL)
+        message(FATAL_ERROR "The Direct3D devices read image files with SDL_image; enable OpenGL or the SDL platform too")
+    endif()
+    target_sources(delta-core PRIVATE
+        src/yds_d3d_file_loading.cpp
+        include/yds_d3d_file_loading.h
+    )
+
     set(
         DXGI_LIBS
         ${CMAKE_CURRENT_SOURCE_DIR}/dependencies/libraries/DXGI/lib/${TARGET_ARCHITECTURE})
-    target_include_directories(delta-core PUBLIC dependencies/libraries/D3DX/include)
-
     target_link_libraries(delta-core PRIVATE
-        # D3DX
         d3d9
         d3d10
         d3d11
-        $<$<CONFIG:Debug>:${D3DX_LIBS}/d3dx9d.lib>
-        $<$<NOT:$<CONFIG:Debug>>:${D3DX_LIBS}/d3dx9.lib>
-        $<$<CONFIG:Debug>:${D3DX_LIBS}/d3dx10d.lib>
-        $<$<NOT:$<CONFIG:Debug>>:${D3DX_LIBS}/d3dx10.lib>
-        $<$<CONFIG:Debug>:${D3DX_LIBS}/d3dx11d.lib>
-        $<$<NOT:$<CONFIG:Debug>>:${D3DX_LIBS}/d3dx11.lib>
-        ${D3DX_LIBS}/d3dxof.lib
+        d3dcompiler
 
         # DXGI
         ${DXGI_LIBS}/DxErr.lib
