index 8989897e..83d29c85 100644
--- a/include/yds_opengl_shader.h
+++ b/include/yds_opengl_shader.h
@@ -3,6 +3,9 @@
 
 #include "yds_shader.h"
 
+#include <string>
+#include <vector>
+
 class ysOpenGLShader : public ysShader {
     friend class ysOpenGLDevice;
 
@@ -10,8 +13,17 @@ public:
     ysOpenGLShader();
     virtual ~ysOpenGLShader();
 
+    // A binding point declared with layout(binding = N) in the shader
