From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:45:50 +0300
Subject: [PATCH] Release keys that Windows no longer reports as held

Raw input can still miss a key's release after patch 0008, for example when
the event arrives without a device handle (input injected by keyboard
software) or while the window doesn't have focus, and the key then stays held
in the game. After pumping messages each frame, compare the keys we think are
held with the thread's key state from GetKeyState and release the ones
Windows says are up. GetKeyState follows the legacy keyboard messages already
taken off the queue, so a release that is still queued is never applied
early. While no window has focus (and global input is off) every key is
released, since raw input is ignored then.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/yds_windows_input_system.h |  3 +++
 src/yds_windows_input_system.cpp   | 30 ++++++++++++++++++++++++++++++
 src/yds_windows_window_system.cpp  |  3 +++
 3 files changed, 36 insertions(+)

diff --git a/include/yds_windows_input_system.h b/include/yds_windows_input_system.h
index 579935b8..7185d665 100644
--- a/include/yds_windows_input_system.h
+++ b/include/yds_windows_input_system.h
@@ -14,6 +14,9 @@ public:
 
     int ProcessInputMessage(HRAWINPUT lparam);
 
+    // Release keys that Windows no longer reports as held
+    void ReleaseLostKeys();
+
 protected:
     virtual ysError CreateDevices();
 
diff --git a/src/yds_windows_input_system.cpp b/src/yds_windows_input_system.cpp
index 53e0a445..35ac83e7 100644
--- a/src/yds_windows_input_system.cpp
+++ b/src/yds_windows_input_system.cpp
@@ -15,6 +15,36 @@ ysWindowsInputSystem::~ysWindowsInputSystem() {
     /* void */
 }
 
+void ysWindowsInputSystem::ReleaseLostKeys() {
+    // Raw input can miss a key's release: it arrives on another HID interface,
+    // without a device handle, or while the window doesn't have focus. The
+    // thread's key state (GetKeyState) is updated by the legacy keyboard
+    // messages we've already pulled off the queue, so it's in step with the raw
+    // events processed so far and can't release a key whose release is still queued.
+    bool active = IsGlobalInputEnabled();
+    for (int i = 0; i < m_windowSystem->GetWindowCount(); ++i) {
+        active = active || m_windowSystem->GetWindow(i)->IsActive();
+    }
+
+    bool held[(int)ysKey::Code::Count] = {};
+    if (active) {
+        const ysKey::Code *keyMap = ysKeyMaps::GetWindowsKeyMap();
+        for (int vk = 1; vk < 256; ++vk) {
+            const ysKey::Code key = keyMap[vk];
+            if (key != ysKey::Code::Undefined && (GetKeyState(vk) & 0x8000) != 0) {
+                held[(int)key] = true;
+            }
+        }
+    }
+
+    for (int i = 0; i < (int)ysKey::Code::Count; ++i) {
+        const ysKey::Code key = (ysKey::Code)i;
+        if (m_keyboardAggregator.IsKeyDown(key) && !held[i]) {
+            m_keyboardAggregator.SetKeyState(key, ysKey::State::UpTransition, ysKey::Variation::Undefined);
+        }
+    }
+}
+
 ysInputDevice::InputDeviceType ysWindowsInputSystem::TranslateType(int type) {
     switch (type) {
     case RIM_TYPEHID:
diff --git a/src/yds_windows_window_system.cpp b/src/yds_windows_window_system.cpp
index de650f79..93205f40 100644
--- a/src/yds_windows_window_system.cpp
+++ b/src/yds_windows_window_system.cpp
@@ -71,6 +71,9 @@ void ysWindowsWindowSystem::ProcessMessages() {
         TranslateMessage(&msg);
         DispatchMessage(&msg);
     }
+
+    ysWindowsInputSystem *inputSystem = static_cast<ysWindowsInputSystem *>(GetInputSystem());
+    if (inputSystem != nullptr) inputSystem->ReleaseLostKeys();
 }
 
 ysWindow *ysWindowsWindowSystem::FindWindowFromHandle(HWND handle) {
