From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Tue, 17 Nov 2026 01:30:00 +0300
Subject: [PATCH] Build with current GCC and Xcode

Headers that use the fixed-width integer types now include <cstdint>
themselves, and the OpenGL device includes <cassert> for its assert:
current standard libraries no longer pull these in through other headers.
On macOS, the OpenGL headers path was added to a misspelled target
("delta-code"), which stopped CMake, delta-physics couldn't find
sse2neon.h on Apple Silicon because only delta-core had its include
directory, and delta-basic linked its libraries whole with GNU ld's
--whole-archive, which Apple's linker doesn't have (it uses -force_load).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -352,7 +352,7 @@ if(ENABLE_OPENGL)
     target_include_directories(delta-core PRIVATE dependencies/libraries/OpenGL/include)
 
     if (APPLE)
-        target_include_directories(delta-code PRIVATE
+        target_include_directories(delta-core PRIVATE
             "${OPENGL_INCLUDE_DIR}/Headers"
         )
     endif()
diff --git a/engines/basic/CMakeLists.txt b/engines/basic/CMakeLists.txt
--- a/engines/basic/CMakeLists.txt
+++ b/engines/basic/CMakeLists.txt
@@ -80,6 +80,12 @@ add_library(delta-basic STATIC
 if (WIN32)
     set(LINK_WHOLE_ARCHIVE_START "")
     set(LINK_WHOLE_ARCHIVE_END "")
+elseif (APPLE)
+    # Apple's linker has no --whole-archive; -force_load takes one archive each
+    set(LINK_WHOLE_ARCHIVE_START "")
+    set(LINK_WHOLE_ARCHIVE_END
+        -Wl,-force_load,$<TARGET_FILE:delta-core>
+        -Wl,-force_load,$<TARGET_FILE:delta-physics>)
 else()
     set(LINK_WHOLE_ARCHIVE_START -Wl,--push-state,--whole-archive)
     set(LINK_WHOLE_ARCHIVE_END -Wl,--pop-state)
