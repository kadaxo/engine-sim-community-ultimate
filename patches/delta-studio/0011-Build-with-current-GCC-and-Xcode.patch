diff --git a/physics/CMakeLists.txt b/physics/CMakeLists.txt
--- a/physics/CMakeLists.txt
+++ b/physics/CMakeLists.txt
@@ -35,3 +35,7 @@ add_library(delta-physics
     src/rigid_body_system.cpp
     src/spring_link.cpp
 )
