From ceb52b573f95327d93e0ebe3521d81b7d891ac5b Mon Sep 17 00:00:00 2001
From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Mon, 26 Oct 2026 12:51:13 +0300
Subject: [PATCH] Make ysWindowsWindow override the std::string window methods
 again

"Use std::string everywhere in yds_*" changed ysWindow::InitializeWindow()
and SetTitle() to take std::string, but ysWindowsWindow kept its
const char * versions. Those no longer override anything, so on Windows the
base implementation ran instead: CreateWindow() was never called, the game
window had no HWND, and creating the D3D11 swap chain (and registering raw
input) failed, after which the application crashed on a null render
target. Use the base signatures, mark them override, and pass c_str() to
the Win32 calls.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/yds_windows_window.h |  6 +++---
 src/yds_windows_window.cpp   | 10 +++++-----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/include/yds_windows_window.h b/include/yds_windows_window.h
index 8f479403..44108232 100644
--- a/include/yds_windows_window.h
+++ b/include/yds_windows_window.h
@@ -16,8 +16,8 @@ public:
 
     // Overrides
 
-    virtual ysError InitializeWindow(ysWindow *parent, const char *title, WindowStyle style, int x, int y, int width, int height, ysMonitor *monitor, ysContextObject::DeviceAPI api);
-    virtual ysError InitializeWindow(ysWindow *parent, const char *title, WindowStyle style, ysMonitor *monitor, ysContextObject::DeviceAPI api);
+    virtual ysError InitializeWindow(ysWindow *parent, std::string title, WindowStyle style, int x, int y, int width, int height, ysMonitor *monitor, ysContextObject::DeviceAPI api) override;
+    virtual ysError InitializeWindow(ysWindow *parent, std::string title, WindowStyle style, ysMonitor *monitor, ysContextObject::DeviceAPI api) override;
 
     virtual bool SetWindowStyle(WindowStyle style);
 
@@ -44,7 +44,7 @@ protected:
     // Abstraction Layer
 
     virtual void Close();
-    virtual void SetTitle(const char *title);
+    virtual void SetTitle(std::string title) override;
     virtual void SetState(WindowState state = WindowState::Visible);
 
     virtual void AL_SetSize(int width, int height);
diff --git a/src/yds_windows_window.cpp b/src/yds_windows_window.cpp
index 56810ac3..1c6fc766 100644
--- a/src/yds_windows_window.cpp
+++ b/src/yds_windows_window.cpp
@@ -30,7 +30,7 @@ ATOM ysWindowsWindow::RegisterWindowsClass() {
     return RegisterClassEx(&wc);
 }
 
-ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, const char *title, WindowStyle style, int x, int y, int width, int height, ysMonitor *monitor, ysContextObject::DeviceAPI api) {
+ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, std::string title, WindowStyle style, int x, int y, int width, int height, ysMonitor *monitor, ysContextObject::DeviceAPI api) {
     YDS_ERROR_DECLARE("InitializeWindow");
 
     if (!CheckCompatibility(parent)) return YDS_ERROR_RETURN(ysError::IncompatiblePlatforms);
@@ -48,7 +48,7 @@ ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, const char *title, W
 
     m_hwnd = CreateWindow(
         "GAME_ENGINE_WINDOW",
-        title,
+        title.c_str(),
         win32Style,
         CW_USEDEFAULT,
         CW_USEDEFAULT,
@@ -67,7 +67,7 @@ ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, const char *title, W
     return YDS_ERROR_RETURN(ysError::None);
 }
 
-ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, const char *title, WindowStyle style, ysMonitor *monitor, ysContextObject::DeviceAPI api) {
+ysError ysWindowsWindow::InitializeWindow(ysWindow *parent, std::string title, WindowStyle style, ysMonitor *monitor, ysContextObject::DeviceAPI api) {
     YDS_ERROR_DECLARE("InitializeWindow");
 
     YDS_NESTED_ERROR_CALL(InitializeWindow(parent, title, style, monitor->GetOriginX(), monitor->GetOriginY(), monitor->GetPhysicalWidth(), monitor->GetPhysicalHeight(), monitor, api));
@@ -205,10 +205,10 @@ void ysWindowsWindow::Close() {
     m_hwnd = NULL;
 }
 
-void ysWindowsWindow::SetTitle(const char *title) {
+void ysWindowsWindow::SetTitle(std::string title) {
     ysWindow::SetTitle(title);
 
-    SetWindowText(m_hwnd, title);
+    SetWindowText(m_hwnd, title.c_str());
 }
 
 void ysWindowsWindow::SetState(WindowState state) {
