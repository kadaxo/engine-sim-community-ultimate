From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kadaxo <105596590+kadaxo@users.noreply.github.com>
Date: Tue, 17 Nov 2026 01:30:00 +0300
Subject: [PATCH] Map the function, navigation and zero keys in the SDL keyboard

The SDL key map only had letters, 1-9, the arrows and a few others, so on
Linux and macOS F1-F12, Page Up/Down, Home, End, Insert, 0, [ and ] did
nothing. engine-sim uses them for its screen reader readouts, as a keyboard
replacement for the mouse wheel, in the spoken engine list, to step through
engines and for slow motion and view rotation.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/yds_sdl_key_maps.cpp | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/yds_sdl_key_maps.cpp b/src/yds_sdl_key_maps.cpp
--- a/src/yds_sdl_key_maps.cpp
+++ b/src/yds_sdl_key_maps.cpp
@@ -51,6 +51,30 @@ const ysKey::Code *ysKeyMaps::GetSdlKeyMap() {
         m_sdlKeyMap[SDL_SCANCODE_LEFT] = ysKey::Code::Left;
         m_sdlKeyMap[SDL_SCANCODE_RIGHT] = ysKey::Code::Right;
 
+        m_sdlKeyMap[SDL_SCANCODE_0] = ysKey::Code::N0;
+
+        m_sdlKeyMap[SDL_SCANCODE_PAGEUP] = ysKey::Code::PageUp;
+        m_sdlKeyMap[SDL_SCANCODE_PAGEDOWN] = ysKey::Code::PageDown;
+        m_sdlKeyMap[SDL_SCANCODE_HOME] = ysKey::Code::Home;
+        m_sdlKeyMap[SDL_SCANCODE_END] = ysKey::Code::End;
+        m_sdlKeyMap[SDL_SCANCODE_INSERT] = ysKey::Code::Insert;
+
+        m_sdlKeyMap[SDL_SCANCODE_LEFTBRACKET] = ysKey::Code::OEM_4;
+        m_sdlKeyMap[SDL_SCANCODE_RIGHTBRACKET] = ysKey::Code::OEM_6;
+
+        m_sdlKeyMap[SDL_SCANCODE_F1] = ysKey::Code::F1;
+        m_sdlKeyMap[SDL_SCANCODE_F2] = ysKey::Code::F2;
+        m_sdlKeyMap[SDL_SCANCODE_F3] = ysKey::Code::F3;
+        m_sdlKeyMap[SDL_SCANCODE_F4] = ysKey::Code::F4;
+        m_sdlKeyMap[SDL_SCANCODE_F5] = ysKey::Code::F5;
+        m_sdlKeyMap[SDL_SCANCODE_F6] = ysKey::Code::F6;
+        m_sdlKeyMap[SDL_SCANCODE_F7] = ysKey::Code::F7;
+        m_sdlKeyMap[SDL_SCANCODE_F8] = ysKey::Code::F8;
+        m_sdlKeyMap[SDL_SCANCODE_F9] = ysKey::Code::F9;
+        m_sdlKeyMap[SDL_SCANCODE_F10] = ysKey::Code::F10;
+        m_sdlKeyMap[SDL_SCANCODE_F11] = ysKey::Code::F11;
+        m_sdlKeyMap[SDL_SCANCODE_F12] = ysKey::Code::F12;
+
         m_sdlKeyMap[SDL_SCANCODE_TAB] = ysKey::Code::Tab;
         m_sdlKeyMap[SDL_SCANCODE_ESCAPE] = ysKey::Code::Escape;
         m_sdlKeyMap[SDL_SCANCODE_SPACE] = ysKey::Code::Space;
